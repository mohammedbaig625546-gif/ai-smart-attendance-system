{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/student/feedback",
      "destination": "/student-feedback.html"
    },
    {
      "source": "/teacher/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/teacher",
      "destination": "/index.html"
    },
    {
      "source": "/student",
      "destination": "/index.html"
    },
    {
      "source": "/attendance",
      "destination": "/index.html"
    },
    {
      "source": "/analytics",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    }
  ]
}
