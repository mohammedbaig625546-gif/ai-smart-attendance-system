# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR SMART ATTENDANCE & FEEDBACK SYSTEM
# ==============================================================================

# Application Port (Development only, default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# PUBLIC APPLICATION URL (For Dynamic QR Code URL Generation)
# ------------------------------------------------------------------------------
# Local Development: Leave empty (auto-detects LAN IP for mobile phone testing)
# or set explicitly:
# PUBLIC_APP_URL=http://192.168.1.89:3000
#
# Production (Vercel):
# Set this in your Vercel Project Settings -> Environment Variables:
# PUBLIC_APP_URL=https://your-attendance-app.vercel.app
PUBLIC_APP_URL=https://your-app-domain.vercel.app

# ------------------------------------------------------------------------------
# FRONTEND API CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
# If deploying frontend and backend to different origins, specify the API domain.
# Defaults to same-origin relative URLs (/api/...) if left unset.
# VITE_API_URL=https://your-app-domain.vercel.app

# ------------------------------------------------------------------------------
# FIREBASE ADMIN SDK (BACKEND ONLY - SECRETS)
# NEVER commit real credentials to Git or expose in frontend code.
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwgg...==\n-----END PRIVATE KEY-----\n"

# Alternative Option for local development:
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ------------------------------------------------------------------------------
# FIREBASE CLIENT WEB SDK (FRONTEND - OPTIONAL)
# Only required if using client-side Firebase Auth/Firestore SDK directly.
# ------------------------------------------------------------------------------
# VITE_FIREBASE_API_KEY=AIzaSy...
# VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
# VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
